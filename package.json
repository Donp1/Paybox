{
  "name": "bountydesk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": { "node": ">=24 <25" },
  "pnpm": { "overrides": { "utf-8-validate": "5.0.10" } },
  "scripts": {
    "dev": "corepack pnpm --filter @bountydesk/web dev",
    "worker:dev": "corepack pnpm --filter @bountydesk/worker dev",
    "lint": "eslint apps packages scripts --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run packages/contracts/src/env.test.ts tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contracts": "vitest run tests/contracts",
    "test:e2e": "playwright test",
    "build": "corepack pnpm typecheck && corepack pnpm --filter @bountydesk/web build && corepack pnpm --filter @bountydesk/worker build",
    "db:migrate": "corepack pnpm --filter @bountydesk/db migrate",
    "db:seed:demo": "corepack pnpm --filter @bountydesk/db seed:demo"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@paybox-sh/sdk": "2.2.0",
    "@types/node": "24.10.4",
    "@types/pg": "8.23.1",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
